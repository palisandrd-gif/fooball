{
  "name": "matchmind-bot-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for football fixtures, results, history and safe AI match explanations.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bot/index.ts",
    "start": "node dist/bot/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema src/db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema src/db/schema.prisma",
    "sync:openfootball": "tsx src/scripts/sync-openfootball.ts",
    "cron:openfootball": "node dist/scripts/sync-openfootball.js",
    "sync:statsbomb": "tsx src/scripts/sync-statsbomb.ts",
    "sync:statsbomb-details": "tsx src/scripts/sync-statsbomb-details.ts",
    "sync:api-football": "tsx src/scripts/sync-api-football.ts",
    "sync:thesportsdb": "tsx src/scripts/sync-thesportsdb.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.2.0",
    "openai": "^5.11.0",
    "pino": "^9.7.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "prisma": "^6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
